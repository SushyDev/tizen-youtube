<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://tube.local" version="0.3.1" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:allow-navigation href="*"/>
    <tizen:application id="tUb3Xq7Lm9.Tube" package="tUb3Xq7Lm9" required_version="2.3"/>
    <author>tube</author>
    <content src="ui/dist/index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="icon.png"/>

    <name>YouTube</name>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>

    <!-- injector.js and dial.js derive this id from the package id, so the suffix must match. -->
    <tizen:service id="tUb3Xq7Lm9.TubeService">
        <tizen:content src="service/dist/index.js"/>
        <tizen:name>TubeService</tizen:name>
        <tizen:description>Injection, proxy fallback and DIAL discovery.</tizen:description>
    </tizen:service>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
