<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns:tizen="http://tizen.org/ns/widgets" xmlns="http://www.w3.org/ns/widgets" id="https://tube.local" version="0.3.1" viewmodes="maximized">
    <access origin="*" subdomains="true"></access>
    <tizen:allow-navigation href="*"/>
    <tizen:application id="tUb3Xq7Lm9.Tube" package="tUb3Xq7Lm9" required_version="5.0"/>
    <author>tube</author>
    <content src="ui/dist/index.html"/>
    <feature name="http://tizen.org/feature/screen.size.all"/>
    <feature name="http://tizen.org/feature/web.service"/>
    <icon src="icon.png"/>

    <!-- Undocumented, and none of them changed playback when removed or restored. Kept for
         now only because they came with the app.

         use.game.mode is deliberately absent, and must stay absent. It is the one switch
         that makes the platform's renderer count frames — which is the only real number
         this app could ever check its own arithmetic against — but it also stops the
         platform playing a URL at all: the element takes the src and sits at networkState
         0 with no error, so the enhanced player never attaches and every video falls back
         to the default one. Three cold starts each way, same code, same video.

         `TUBE_GAME_MODE=1 npm run package` adds it to the staged copy for measuring. -->
    <tizen:metadata key="http://samsung.com/tv/metadata/prelaunch.support" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/floating.navigation" value="false"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/use.uwe" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/no_use_process_pool" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/html5.4k.support" value="true"/>

    <!-- From Samsung's own NativePlayer sample: a video app declares it does not
         multitask, which is the closest thing found to a rendering-priority hint. -->
    <tizen:metadata key="http://samsung.com/tv/metadata/multitasking.support" value="false"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/voice.support" value="false"/>

    <!-- Jellyfin sets this on Tizen; a different namespace from the samsung.com keys. -->
    <tizen:metadata key="http://tizen.org/metadata/app_ui_type/base_screen_resolution" value="fullscreen"/>

    <!-- Declaring no API generation may be what gets this app the platform's legacy
         defaults on a Tizen 9 set. The page is served over http and pulls media over
         https, which is the mixed content this asks to be allowed. -->
    <tizen:metadata key="http://samsung.com/tv/metadata/devel.api.version" value="5.5"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/allow.mixedcontent" value="true"/>
    <tizen:metadata key="http://samsung.com/tv/metadata/runningtype" value="MAIN"/>

    <name>YouTube</name>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://tizen.org/privilege/unlimitedstorage"/>
    <tizen:privilege name="http://tizen.org/privilege/application.launch"/>

    <tizen:setting screen-orientation="landscape" context-menu="enable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:profile name="tv-samsung"/>

    <!-- injector.js and dial.js derive this id from the package id, so the suffix must match. -->
    <tizen:service id="tUb3Xq7Lm9.TubeService">
        <tizen:content src="service/dist/index.js"/>
        <tizen:name>TubeService</tizen:name>
        <tizen:description>Injection, proxy fallback and DIAL discovery.</tizen:description>
    </tizen:service>

    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="enable" encryption="disable" install-location="auto" hwkey-event="enable"/>
</widget>
